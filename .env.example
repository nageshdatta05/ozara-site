# ============================================================================
# OZARA — environment configuration
# Copy to .env.local (development) or set in your host's dashboard (production).
# Variables starting NEXT_PUBLIC_ are shown in the browser — never put secrets
# in them. Everything else stays on the server.
# ============================================================================

# ── Site ────────────────────────────────────────────────────────────────────
# The canonical public address (no trailing slash). Also written into every
# NFC tag as <URL>/b/<BRACELET_ID> — choose it once and never change it.
OZARA_PUBLIC_URL=https://ozara.co
NEXT_PUBLIC_SITE_URL=https://ozara.co

# Public contact email. Leave empty to send people to the contact form only.
NEXT_PUBLIC_CONTACT_EMAIL=

# Business details for the Privacy Policy, Terms and Contact page (leave empty to omit).
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_REGISTRATION=
NEXT_PUBLIC_GOVERNING_LAW=

# ── Security (required in production) ───────────────────────────────────────
# Admin dashboard (/admin/nfc). A long random password.
OZARA_ADMIN_PASSWORD=change-me
# Signs every session cookie (customers, staff, admin). 32+ random characters.
OZARA_SESSION_SECRET=change-me-to-32-plus-random-characters

# ── Database ────────────────────────────────────────────────────────────────
# SQLite file on a persistent disk (default ./data/ozara.db). Back it up.
# OZARA_DB_PATH=./data/ozara.db

# ── Email (Resend — https://resend.com) ─────────────────────────────────────
# Without these, nothing is emailed (password resets, order confirmations,
# enquiry copies); attempts are listed in /admin/nfc/messages.
RESEND_API_KEY=
EMAIL_FROM="OZARA <hello@ozara.co>"
# Where new enquiries and reservations are copied.
OZARA_INBOX_EMAIL=

# ── Payments ────────────────────────────────────────────────────────────────
# Not connected. See src/server/payments.ts (Stripe steps), then set
# payments.provider in src/config/site.ts.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Demo data (development only — NEVER in production) ──────────────────────
# true = on an empty database, create demo bracelets BR-000001…005 and demo
# events, all clearly marked as demonstration records.
OZARA_SEED_DEMO=false
# Organiser code for the demo event, and the claim code for demo bracelets.
OZARA_DEMO_EVENT_CODE=LAUNCH2026
OZARA_DEMO_CLAIM_CODE=DEMO-CLAIM
